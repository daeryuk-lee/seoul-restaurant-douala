---
import { Image } from 'astro:assets';
import bbqImage from '../assets/images/food/bbq.jpg';
import bibimbapImage from '../assets/images/food/bibimbap.jpg';
import grilladeImage from '../assets/images/food/grillade.jpg';
import kimbapImage from '../assets/images/food/kimbap.jpg';
import sushiImage from '../assets/images/food/sushi.jpg';
import supplementsImage from '../assets/images/food/supplements.jpg';
import DishItem from '../components/DishItem.astro';
import HoursList from '../components/HoursList.astro';
import HomeFilm from '../components/HomeFilm.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { newDishesUntil, site } from '../config/site';
import { bbqOpening, newDishes } from '../data/menu';
import { pathTo, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { formatPrice } from '../lib/format';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const h = t.home;

const signatureImages = [bbqImage, sushiImage, kimbapImage, bibimbapImage];
const showNews = newDishes.length > 0 && new Date().toISOString().slice(0, 10) <= newDishesUntil;

// Anciennes ancres de la version précédente du site (liens déjà partagés)
const legacyHashes = {
  menu: pathTo(locale, 'menu'),
  specialties: pathTo(locale, 'menu'),
  reservation: pathTo(locale, 'reservation'),
  contact: pathTo(locale, 'visit'),
};
---

<div data-legacy-hashes={JSON.stringify(legacyHashes)} hidden></div>

<!-- Ouverture : film des plats, piloté par le défilement -->
<HomeFilm locale={locale} />

<!-- La maison -->
<section id="maison" class="section theme-char intro" aria-labelledby="intro-title">
  <div class="container intro__grid">
    <div class="intro__text reveal">
      <p class="kicker">{h.intro.kicker}</p>
      <h2 id="intro-title">{h.intro.title}</h2>
      {h.intro.body.map((paragraph) => <p>{paragraph}</p>)}
      <a class="link-arrow" href={pathTo(locale, 'menu')}>
        {h.signatures.cta}
        <Icon name="arrow" />
      </a>
    </div>
    <div class="intro__media" aria-hidden="true">
      <span class="intro__hangul" lang="ko">서울</span>
      <Image
        src={supplementsImage}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 34vw, 80vw"
        class="intro__img intro__img--main reveal"
      />
      <Image
        src={grilladeImage}
        alt=""
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 22vw, 55vw"
        class="intro__img intro__img--accent reveal"
      />
    </div>
  </div>
</section>

<!-- Signatures -->
<section class="section theme-ink signatures" aria-labelledby="signatures-title">
  <div class="container">
    <SectionHeading id="signatures-title" kicker={h.signatures.kicker} title={h.signatures.title} />
    <ol class="signatures__list" role="list">
      {
        h.signatures.items.map((item, index) => (
          <li class="signature reveal">
            <div class="signature__frame" data-tilt>
              <Image
                src={signatureImages[index]!}
                alt=""
                widths={[400, 600, 800]}
                sizes="(min-width: 1100px) 23vw, (min-width: 640px) 45vw, 90vw"
                class="signature__img"
              />
            </div>
            <p class="signature__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3>{item.title}</h3>
            <p class="signature__text">{item.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="signatures__cta">
      <a class="btn" href={pathTo(locale, 'menu')}>{h.signatures.cta}</a>
    </div>
  </div>
</section>

<!-- Le barbecue -->
<section class="bbq theme-ink" aria-labelledby="bbq-title">
  <div class="bbq__media">
    <Image src={bbqImage} alt="" widths={[640, 960, 1280, 1408]} sizes="(min-width: 1024px) 55vw, 100vw" class="bbq__img" />
  </div>
  <div class="bbq__text reveal">
    <p class="kicker">{h.bbq.kicker}</p>
    <h2 id="bbq-title">{h.bbq.title}</h2>
    <p>{h.bbq.body}</p>
    {
      bbqOpening && typeof bbqOpening.price === 'number' && (
        <p class="bbq__offer">
          <span>{h.bbq.offer}</span>
          <strong>
            {formatPrice(bbqOpening.price, locale)} {t.menu.currency}
          </strong>
        </p>
      )
    }
    <a class="btn btn--solid" href={`${pathTo(locale, 'reservation')}?table=bbq`}>{h.bbq.cta}</a>
  </div>
</section>

<!-- Nouveautés -->
{
  showNews && (
    <section class="section theme-char news" aria-labelledby="news-title" data-expires={newDishesUntil}>
      <div class="container">
        <SectionHeading id="news-title" kicker={h.news.kicker} title={h.news.title} intro={h.news.intro} />
        <ul class="news__list" role="list">
          {newDishes.map((dish) => (
            <DishItem dish={dish} locale={locale} />
          ))}
        </ul>
        <a class="link-arrow news__cta" href={pathTo(locale, 'menu')}>
          {h.news.cta}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  )
}

<!-- Nous rendre visite -->
<section class="section theme-ink visit" aria-labelledby="visit-title">
  <div class="container visit__grid">
    <div class="visit__text reveal">
      <p class="kicker">{h.visit.kicker}</p>
      <h2 id="visit-title">{h.visit.title}</h2>
      <p class="lead">{h.visit.body}</p>
      <OpenStatus locale={locale} />
      <div class="visit__actions">
        <a class="btn" href={pathTo(locale, 'visit')}>
          <Icon name="map" />
          {h.visit.cta}
        </a>
        <a class="btn" href={`tel:${site.phone.e164}`}>
          <Icon name="phone" />
          {site.phone.display}
        </a>
      </div>
    </div>
    <div class="visit__hours reveal">
      <h3 class="visually-hidden">{t.hours.title}</h3>
      <HoursList locale={locale} />
    </div>
  </div>
</section>

<!-- Réserver -->
<section class="section theme-char closing" aria-labelledby="closing-title">
  <div class="container closing__inner reveal">
    <span class="rule" aria-hidden="true"></span>
    <h2 id="closing-title">{h.closing.title}</h2>
    <p class="lead">{h.closing.body}</p>
    <div class="closing__actions">
      <a class="btn btn--solid" href={pathTo(locale, 'reservation')}>{t.nav.bookLong}</a>
      <a class="btn" href={`tel:${site.phone.e164}`}>
        <Icon name="phone" />
        {t.contact.call}
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/tilt';
</script>

<style>
  /* ── La maison ── */
  .intro__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .intro__grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .intro__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .intro__text h2 {
    font-size: var(--step-4);
    font-weight: 350;
    max-width: 16ch;
  }

  .intro__text p:not(.kicker) {
    max-width: 52ch;
    color: var(--muted);
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.6;
  }

  .intro__media {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto;
    padding-block: 2rem 4rem;
  }

  .intro__img {
    inline-size: 100%;
    object-fit: cover;
  }

  .intro__img--main {
    grid-column: 1 / 11;
    grid-row: 1;
    aspect-ratio: 4 / 5;
  }

  .intro__img--accent {
    grid-column: 7 / 13;
    grid-row: 1;
    align-self: end;
    aspect-ratio: 1;
    translate: 0 4rem;
    border: clamp(6px, 1vw, 12px) solid var(--bg);
  }

  .intro__hangul {
    position: absolute;
    inset: 0 auto auto -0.5rem;
    translate: -40% 0;
    z-index: 1;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    line-height: 1;
    letter-spacing: 0.3em;
    color: var(--accent);
    opacity: 0.55;
  }

  @media (max-width: 1023px) {
    .intro__hangul {
      display: none;
    }
  }

  /* ── Signatures ── */
  .signatures__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .signature {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    perspective: 900px;
  }

  /* Carte en perspective : inclinaison pilotée par src/scripts/tilt.ts */
  .signature__frame {
    position: relative;
    margin-bottom: 0.75rem;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }

  .signature__frame[data-tilting] {
    transition: transform 0.12s linear;
  }

  .signature__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgb(255 230 180 / 0.22), transparent 55%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  .signature__frame[data-tilting]::after {
    opacity: 1;
  }

  .signature__frame::before {
    /* liseré doré qui « flotte » au-dessus de la photo */
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1px solid color-mix(in srgb, var(--brass) 35%, transparent);
    transform: translateZ(30px);
    pointer-events: none;
  }

  .signature__img {
    inline-size: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      filter 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  .signature:hover .signature__img {
    filter: saturate(1.05);
  }

  .signature__index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--accent);
  }

  .signature h3 {
    font-size: var(--step-2);
    font-weight: 400;
  }

  .signature__text {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .signatures__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  /* ── Le barbecue ── */
  .bbq {
    display: grid;
    background: var(--bg-raised);
    color: var(--fg);
  }

  @media (min-width: 1024px) {
    .bbq {
      grid-template-columns: 1.15fr 1fr;
      min-block-size: 44rem;
    }
  }

  .bbq__media {
    position: relative;
    min-block-size: 22rem;
  }

  .bbq__img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .bbq__text {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding: clamp(3.5rem, 2rem + 5vw, 7rem) var(--gutter);
    max-inline-size: 40rem;
  }

  .bbq__text h2 {
    font-size: var(--step-4);
    font-weight: 350;
  }

  .bbq__text > p:not(.kicker, .bbq__offer) {
    color: var(--muted);
    font-size: var(--step-1);
    font-weight: 300;
  }

  .bbq__offer {
    display: grid;
    gap: 0.35rem;
    inline-size: 100%;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    color: var(--muted);
  }

  .bbq__offer strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 450;
    color: var(--accent-strong);
    font-variant-numeric: lining-nums;
  }

  /* ── Nouveautés ── */
  .news__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .news__cta {
    margin-top: 2rem;
  }

  /* ── Visite ── */
  .visit__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .visit__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visit__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .visit__text h2 {
    font-size: var(--step-4);
    font-weight: 350;
  }

  .visit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* ── Réserver ── */
  .closing__inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .closing__inner h2 {
    font-size: var(--step-5);
    font-weight: 300;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
