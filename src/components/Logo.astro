---
/**
 * Logo du restaurant : « Seoul » au pinceau, avec ou sans « Restaurant Coréen ».
 * Image SVG générée par scripts/build-brand-assets.mjs à partir du vrai logo : nette à toutes
 * les tailles, téléchargée une seule fois puis gardée en cache.
 */
import full from '../assets/brand/logo.svg';
import word from '../assets/brand/logo-word.svg';

interface Props {
  alt: string;
  /** Largeur d'affichage maximale en pixels CSS. */
  width: number;
  /** « word » : « Seoul » seul (en-tête) ; « full » : avec « Restaurant Coréen » dessous. */
  variant?: 'word' | 'full';
  /** Logo visible dès l'ouverture de la page : chargement prioritaire. */
  eager?: boolean;
  class?: string;
}

const { alt, width, variant = 'word', eager = false, class: className } = Astro.props;
const svg = variant === 'full' ? full : word;
---

<img
  class:list={['logo', className]}
  src={svg.src}
  width={svg.width}
  height={svg.height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  style={`--logo-max:${width}px`}
/>

<style>
  .logo {
    display: block;
    inline-size: 100%;
    max-inline-size: var(--logo-w, var(--logo-max));
    block-size: auto;
  }
</style>
