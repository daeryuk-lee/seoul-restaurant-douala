---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  align?: 'start' | 'center';
}

const { id, kicker, title, intro, align = 'start' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <p class="kicker">{kicker}</p>
  <h2 id={id}>{title}</h2>
  {intro && <p class="lead">{intro}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .section-heading--center {
    justify-items: center;
    text-align: center;
  }

  .section-heading--center .lead {
    margin-inline: auto;
  }

  h2 {
    font-size: var(--step-4);
    font-weight: 350;
    max-width: 18ch;
  }

  :is(:lang(ko), :lang(zh-Hans)) h2 {
    max-width: 22ch;
  }
</style>
