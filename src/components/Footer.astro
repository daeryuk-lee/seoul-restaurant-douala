---
import { site } from '../config/site';
import { pathTo, type Locale, type PageId } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { whatsappUrl } from '../lib/format';
import HoursList from './HoursList.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const socials = [
  { href: site.social.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.social.facebook, icon: 'facebook', label: 'Facebook' },
  { href: site.social.tripadvisor, icon: 'tripadvisor', label: 'Tripadvisor' },
] as const;
---

<footer class="site-footer theme-ink">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo alt={site.fullName} width={260} variant="full" />
        <p>{t.brand.tagline}</p>
      </div>
      <a class="btn btn--solid" href={pathTo(locale, 'reservation')}>{t.nav.bookLong}</a>
    </div>

    <div class="site-footer__grid">
      <section aria-labelledby="footer-address">
        <h2 id="footer-address">{t.contact.address}</h2>
        <address>
          {site.address.landmark[locale]}<br />
          {site.address.street}<br />
          {site.address.city}, {site.address.country[locale]}
        </address>
        <a class="link-arrow" href={pathTo(locale, 'visit')}>
          {t.contact.directions}
          <Icon name="arrow" />
        </a>
      </section>

      <section aria-labelledby="footer-hours">
        <h2 id="footer-hours">{t.hours.title}</h2>
        <HoursList locale={locale} compact />
      </section>

      <section aria-labelledby="footer-contact">
        <h2 id="footer-contact">{t.contact.phone}</h2>
        <ul role="list" class="site-footer__list">
          <li>
            <a href={`tel:${site.phone.e164}`}><Icon name="phone" />{site.phone.display}</a>
          </li>
          <li>
            <a href={whatsappUrl(site.whatsapp)} target="_blank" rel="noopener"><Icon name="whatsapp" />{t.contact.whatsapp}</a>
          </li>
          {
            site.email && (
              <li>
                <a href={`mailto:${site.email}`}>
                  <Icon name="mail" />
                  {site.email}
                </a>
              </li>
            )
          }
        </ul>
      </section>

      <section aria-labelledby="footer-social">
        <h2 id="footer-social">{t.contact.follow}</h2>
        <ul role="list" class="site-footer__list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  <Icon name={s.icon} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.fullName}. {t.footer.rights}</p>
      <ul role="list" class="site-footer__legal">
        <li><a href={pathTo(locale, 'legal')}>{t.footer.legal}</a></li>
        <li><a href={pathTo(locale, 'privacy')}>{t.footer.privacy}</a></li>
        <li><span>{t.footer.photos}</span></li>
      </ul>
      <LanguageSwitcher locale={locale} page={page} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    color: var(--fg);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) max(2rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .site-footer__brand {
    --logo-w: 260px;
    display: grid;
    gap: 1rem;
  }

  .site-footer__brand p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--muted);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2.5rem clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .site-footer h2 {
    margin-bottom: 1.25rem;
    font-family: var(--font-text);
    font-size: var(--step--2);
    font-weight: 450;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  :is(:lang(ko), :lang(zh-Hans)) .site-footer h2 {
    letter-spacing: 0.08em;
    font-size: var(--step--1);
  }

  address {
    font-style: normal;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .site-footer__list {
    display: grid;
    gap: 0.15rem;
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }

  .site-footer__list a:hover {
    color: var(--fg);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .site-footer__legal a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
</style>
