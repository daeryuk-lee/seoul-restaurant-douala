---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** Photo de fond ; sans photo, bandeau sobre et plus court (pages légales). */
  image?: ImageMetadata;
  kicker: string;
  title: string;
  intro?: string;
  /** Position de cadrage CSS de la photo (object-position). */
  focus?: string;
}

const { image, kicker, title, intro, focus = 'center' } = Astro.props;
---

<section class:list={['page-hero theme-ink', { 'page-hero--plain': !image }]}>
  {
    image && (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="page-hero__image"
        style={`object-position:${focus}`}
      />
    )
  }
  <div class="container page-hero__content">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: clamp(26rem, 62svh, 40rem);
    padding-block: calc(var(--header-h) + 3rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
  }

  .page-hero :global(picture),
  .page-hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
  }

  .page-hero__image {
    object-fit: cover;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(18 16 14 / 0.96) 0%, rgb(18 16 14 / 0.7) 45%, rgb(18 16 14 / 0.45) 100%),
      linear-gradient(to right, rgb(18 16 14 / 0.6), transparent 70%);
  }

  .page-hero--plain {
    min-block-size: 0;
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem)) clamp(2.5rem, 2rem + 2vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero--plain::after {
    content: none;
  }

  .page-hero--plain h1 {
    font-size: var(--step-4);
  }

  .page-hero__content {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 350;
  }

  .lead {
    color: var(--on-ink);
    opacity: 0.86;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero__image {
      animation: settle 2.4s var(--ease-out) both;
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
      opacity: 0.4;
    }
  }
</style>
